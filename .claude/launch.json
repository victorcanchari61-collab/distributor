{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "Frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "Backend/Backend"],
      "port": 5220
    },
    {
      "name": "titanic-web",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd titanic && flutter run -d web-server --web-port 5174 --web-hostname 0.0.0.0"
      ],
      "port": 5174
    }
  ]
}
