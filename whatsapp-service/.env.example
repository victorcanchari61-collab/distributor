# Puerto local donde escucha el servicio (solo 127.0.0.1).
WHATSAPP_PORT=3334

# Debe ser el MISMO valor que "WhatsApp:Token" en appsettings.Production.json del backend.
# Genera uno con: openssl rand -hex 32
WHATSAPP_TOKEN=

# Pausa entre mensajes, en milisegundos. No lo bajes: enviar en ráfaga es lo que hace que bloqueen el número.
WHATSAPP_DELAY_MS=4000
